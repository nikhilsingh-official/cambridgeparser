# Python caches and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
node_modules/

# Local editor and agent state
.idea/
.vscode/
.agents/
.codex/
# Playwright MCP snapshots are ephemeral local test evidence.
.playwright-mcp/

# Logs and temporary files
*.log
*.tmp
*.bak
.DS_Store

# Corpus inputs: large and/or externally sourced
resources/pdfs/
resources/ocr/

# Generated pipeline outputs. src/resources/paths.py is the single source of
# truth for where these live; everything below resources/generated/ and
# resources/legacy/ is produced by the pipeline or kept as historical data.
output/
resources/generated/*
!resources/generated/README.md
resources/legacy/

# Debug and rendered image artifacts
*.png
*.jpg
*.jpeg
*.tif
*.tiff
# these are runtime IDE assets now that the former frontend was merged at
# the repository root. The old src/website/frontend exception matched nothing.
!public/resources/images/
!public/resources/images/*.png
# deployable browser/search assets generated from the transparent vector.
!public/favicon-32x32.png
!public/apple-touch-icon.png
!public/icon-192.png
!public/icon-512.png
!public/og-image.png
!docs/reference/
!docs/reference/*.png


# Rust build artifacts
pseudocode-parser/target/
Cargo.lock

# Firebase
.firebase/
firebase-debug.log
*-debug.log
.runtimeconfig.json
# Local env overrides (public web config lives in firebase.js, not here)
.env
.env.local
.env.*.local

# Vite build output for the website (generated by `npm run build:website`)
src/website/static/

# Vite build output
dist/

# local Supabase CLI scratch state, including emulator service-role keys.
supabase/.temp/

# downloaded grade-threshold PDFs. Regenerate with scripts/gt/build.py;
# the parsed output (data/grade_thresholds.json) is what gets committed.
scripts/gt/cache/

# checksum-pinned Cambridge PDFs are fetched locally for the solver audit.
tests/fixtures/solver-corpus/cache/
