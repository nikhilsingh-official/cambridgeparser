# Python caches and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
node_modules/

# Local editor and agent state
.idea/
.vscode/
.agents/
.codex/

# Logs and temporary files
*.log
*.tmp
*.bak
.DS_Store

# Corpus inputs: large and/or externally sourced
resources/pdfs/
resources/ocr/

# Generated pipeline outputs. src/resources/paths.py is the single source of
# truth for where these live; everything below resources/generated/ and
# resources/legacy/ is produced by the pipeline or kept as historical data.
output/
resources/generated/*
!resources/generated/README.md
resources/legacy/

# Debug and rendered image artifacts
*.png
*.jpg
*.jpeg
*.tif
*.tiff
!src/website/frontend/public/resources/images/
!src/website/frontend/public/resources/images/*.png
!docs/reference/
!docs/reference/*.png


# Rust build artifacts
pseudocode-parser/target/
Cargo.lock

# Firebase
.firebase/
firebase-debug.log
*-debug.log
.runtimeconfig.json
# Local env overrides (public web config lives in firebase.js, not here)
.env
.env.local
.env.*.local

# Vite build output for the website (generated by `npm run build:website`)
src/website/static/

# Vite build output
dist/

# local Supabase CLI scratch state, including emulator service-role keys.
supabase/.temp/

# checksum-pinned Cambridge PDFs are fetched locally for the solver audit.
tests/fixtures/solver-corpus/cache/
