# Copy to .env and fill in for a non-local Supabase project.
#
# One project serves both apps -- the pseudocode IDE (src/website) and the
# Soluer solver (apps/solver) -- so that a sign-in to either is the same
# account. Both Vite configs read this file via `envDir`.
#
# Neither value is a secret: they identify the project, and Row Level Security
# is what actually grants or denies access. Both fall back to the local
# `supabase start` defaults when unset, so `npm run dev:website` and
# `cd apps/solver && npm run dev` work with no .env present.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The Vercel grading function reads the same project through the unprefixed
# names (VITE_ variables are client-side only). Set these in the Vercel
# dashboard for Production and Preview; they are not needed for local dev,
# where api/grade.py falls back to the same localhost defaults.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
