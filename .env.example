# Copy to .env and fill in for a non-local Supabase project.
#
# One Supabase project for the one application. Both halves of the site -- the
# paper solver and the Cambridge IDE -- share it, so a sign-in is a sign-in to
# both.
#
# Neither value is a secret: they identify the project, and Row Level Security
# is what actually grants or denies access. Both fall back to the local
# `supabase start` defaults when unset, so `npm run dev` works with no .env
# present.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The authenticated Supabase grade Edge Function requires at least one provider.
# Google AI Studio is primary; OpenRouter is its rate-limit/transient-outage
# fallback and can also operate alone. Put these in an ignored
# supabase/functions/.env locally,
# or set them with `supabase secrets set` for a hosted project. Never prefix
# them with VITE_ or configure them in Vercel.
GOOGLE_AI_STUDIO_API_KEY=
OPENROUTER_API_KEY=

# Optional provider overrides. Defaults are maintained in the grade function.
# GOOGLE_AI_MODEL=
# GOOGLE_AI_MODELS=
# GOOGLE_AI_BASE_URL=
# GOOGLE_AI_THINKING_BUDGET=
# OPENROUTER_MODEL=
# OPENROUTER_PROVIDER_ONLY=
# OPENROUTER_PROVIDER_SORT=
# OPENROUTER_BASE_URL=
